# ════════════════════════════════════════════════════════════════════
#  University of Karachi Student Portal — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit the actual .env file to version control.
# ════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:root@localhost:5432/university_portal"

JWT_SECRET="507554f70f228ebf087834a887175d94e23e00fc8c895697e18e624c3cc946b8"
JWT_REFRESH_SECRET="507554f70f228ebf087834a887175d94e23e00fc8c895697e18e624c3cc946b8"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ── API Server ────────────────────────────────────────────────────────
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"
COOKIE_SECURE=false          # set true in production (HTTPS)

# ── File Uploads ──────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5
STORAGE_DRIVER=local         # local | s3 (S3 requires additional config)

# ── Next.js Frontend ─────────────────────────────────────────────────
# Exposed to the browser — do not put secrets here
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Internal server-side URL (if using Next.js route proxying)
API_INTERNAL_URL="http://localhost:4000"

# ── Email (optional — leave SMTP_HOST blank to disable) ──────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="portal@university.edu.pk"

# ── Swagger ───────────────────────────────────────────────────────────
SWAGGER_ENABLED=true         # set false in production if desired
